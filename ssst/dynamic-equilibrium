<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Dynamic Equilibrium</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');
  :root{
    --bg:#EEF3F6; --panel:#FFFFFF; --line:#D7E1E6; --text:#1B2733; --muted:#5B7480;
    --reactant-color:#065A82; --reactant-dark:#033F5C;
    --product-color:#C9822A; --product-dark:#8F5D1D;
    --good:#3F7D4F; --focus:#1C7293; --navy:#21295C;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg); color:var(--text); font-family:'Inter',sans-serif;
    min-height:100vh; padding:32px 20px 60px;
  }
  .wrap{max-width:900px; margin:0 auto;}

  header.top{ margin-bottom:22px; }
  header.top h1{ font-family:'Source Serif 4',serif; font-weight:700; font-size:26px; margin:0 0 12px; color:var(--navy); }
  header.top .equation-banner{
    display:flex; align-items:center; justify-content:center;
    background:var(--panel); border:1px solid var(--line); border-radius:8px;
    padding:14px 20px; box-shadow:0 1px 3px rgba(33,41,92,0.06);
  }
  header.top .eq{ font-family:'Source Serif 4',serif; font-size:22px; font-weight:700; }
  header.top .eq .r-c{color:var(--reactant-color);} header.top .eq .p-c{color:var(--product-color);}
  header.top p.sub{margin:10px 2px 0; color:var(--muted); font-size:13.5px; line-height:1.55; max-width:70ch;}

  section.panel{
    background:var(--panel); border:1px solid var(--line); border-radius:10px;
    padding:20px; margin-top:18px; box-shadow:0 1px 3px rgba(33,41,92,0.06);
  }
  .stage{display:grid; grid-template-columns:1fr 1fr; gap:24px; align-items:start;}
  @media (max-width:720px){ .stage{grid-template-columns:1fr;} }

  .panel-title{font-size:12px; color:var(--muted); margin-bottom:8px; text-align:center; letter-spacing:.02em;}

  .beaker-side{display:flex; flex-direction:column; align-items:center;}
  .beaker-stage{position:relative; width:300px; height:270px;}
  .beaker-stage svg.glass{position:absolute; top:0; left:0; width:300px; height:270px; overflow:visible;}
  #moleculeLayer{position:absolute; top:0; left:0; width:300px; height:270px;}
  .molecule{position:absolute; border-radius:50%;}
  .molecule .m-jig{
    width:100%; height:100%; border-radius:50%;
    transition:background 0.4s ease;
    animation-name:jiggle; animation-iteration-count:infinite; animation-timing-function:ease-in-out;
  }
  @keyframes jiggle{
    0%{transform:translate(0,0);} 25%{transform:translate(var(--jx1),var(--jy1));}
    50%{transform:translate(var(--jx2),var(--jy2));} 75%{transform:translate(var(--jx3),var(--jy3));}
    100%{transform:translate(0,0);}
  }
  .counts-caption{margin-top:12px; text-align:center; font-size:13px; color:var(--muted); font-family:'IBM Plex Mono',monospace;}
  .counts-caption .rc{color:var(--reactant-color); font-weight:600;}
  .counts-caption .pc{color:var(--product-color); font-weight:600;}
  .disclaimer{margin-top:10px; text-align:center; font-size:10.5px; color:var(--muted); line-height:1.35; max-width:300px;}

  .graph-side{min-width:0;}
  svg#chart{width:100%; height:auto; display:block;}
  .gridline{stroke:#E3E9EC; stroke-width:1;}
  .axis-label{fill:var(--muted); font-size:11px; font-family:'IBM Plex Mono',monospace;}
  .axis-title{fill:var(--muted); font-size:12px; font-family:'Inter',sans-serif;}
  .curve{fill:none; stroke-width:3;}
  .tip{stroke:#FFFFFF; stroke-width:2;}
  .eqline{stroke:var(--good); stroke-width:1.5; stroke-dasharray:5 4; opacity:0;}
  .eqline-label{fill:var(--good); font-size:11px; font-family:'IBM Plex Mono',monospace; opacity:0;}

  .rates{display:flex; gap:14px; margin-top:16px; flex-wrap:wrap;}
  .rates .box{flex:1; background:var(--panel); border:1px solid var(--line); border-radius:8px; padding:10px 12px; min-width:150px;}
  .rates .box .lbl{font-size:11px; color:var(--muted); display:flex; align-items:center; gap:6px; line-height:1.3;}
  .rates .box .lbl .dot{width:10px; height:10px; border-radius:50%; display:inline-block; flex:0 0 auto;}
  .rates .box .speed-caption{font-size:11px; color:var(--muted); margin-top:8px;}
  .rates .box .speed-big{font-family:'IBM Plex Mono',monospace; margin-top:3px; line-height:1;}
  .rates .box .speed-big b{font-size:30px; font-weight:600;}
  .rates .box .speed-big .unit{font-size:14px; color:var(--muted);}
  .rates .fwd .speed-big b{color:var(--reactant-color);} .rates .fwd .dot{background:var(--reactant-color);}
  .rates .rev .speed-big b{color:var(--product-color);} .rates .rev .dot{background:var(--product-color);}

  .controls{display:flex; gap:10px; margin-top:18px; justify-content:center; flex-wrap:wrap;}
  button.action{
    cursor:pointer; font-family:'Inter',sans-serif; font-weight:600; font-size:13.5px;
    padding:9px 20px; border-radius:6px; border:1px solid var(--line);
    background:#F5F8FA; color:var(--text); transition:border-color .15s ease, background .15s ease;
  }
  button.action:hover{border-color:var(--focus);}
  button.action.primary{background:var(--focus); border-color:var(--focus); color:#FFFFFF;}

  .status{
    margin-top:16px; padding:12px 16px; border-radius:6px; font-size:14px;
    background:#F5F8FA; border:1px solid var(--line); color:var(--text); line-height:1.5; text-align:center;
  }
  .status.eq{border-color:var(--good); background:rgba(63,125,79,0.08);}
  .status b{color:var(--navy);} .status.eq b{color:var(--good);}

  footer.credit{ text-align:center; color:var(--muted); font-size:11.5px; margin-top:26px; line-height:1.6;}
</style>
</head>
<body>
<div class="wrap">

  <header class="top">
    <h1>Dynamic Equilibrium</h1>
    <div class="equation-banner">
      <div class="eq"><span class="r-c">Reactant</span> &#8652; <span class="p-c">Product</span></div>
    </div>
    <p class="sub">Watch the reaction run on its own. Early on, Reactant turns into Product much faster than the reverse &mdash; but look closely: the reverse conversion is happening too, just slowly. As the system settles into equilibrium, the two directions happen at the same speed, and they never stop.</p>
  </header>

  <section class="panel">
    <div class="stage">
      <div class="beaker-side">
        <div class="panel-title">THE MOLECULES</div>
        <div class="beaker-stage" id="beakerStage">
          <svg class="glass" viewBox="0 0 300 270">
            <defs>
              <linearGradient id="liquidGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#CFE3EA" stop-opacity="0.65"/>
                <stop offset="100%" stop-color="#AEC8D3" stop-opacity="0.8"/>
              </linearGradient>
              <linearGradient id="glassGrad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#8FA6AE" stop-opacity="0.7"/>
                <stop offset="12%" stop-color="#FFFFFF" stop-opacity="0.9"/>
                <stop offset="20%" stop-color="#8FA6AE" stop-opacity="0.55"/>
                <stop offset="80%" stop-color="#8FA6AE" stop-opacity="0.55"/>
                <stop offset="88%" stop-color="#FFFFFF" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="#8FA6AE" stop-opacity="0.7"/>
              </linearGradient>
            </defs>
            <path d="M 56 104 L 71 240 L 229 240 L 244 104 Z" fill="url(#liquidGrad)"/>
            <path d="M 56 104 L 244 104" stroke="#6E8B96" stroke-width="1.5" opacity="0.6"/>
            <g stroke="#6E8B96" stroke-width="1.5" opacity="0.65">
              <line x1="62" y1="140" x2="72" y2="140"/>
              <line x1="65" y1="178" x2="75" y2="178"/>
              <line x1="68" y1="216" x2="78" y2="216"/>
            </g>
            <path d="M 47 24 L 71 240 L 229 240 L 253 24" fill="none" stroke="url(#glassGrad)" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"/>
            <path d="M 47 24 L 71 240 L 229 240 L 253 24" fill="none" stroke="#7A96A0" stroke-width="1" stroke-linejoin="round" stroke-linecap="round" opacity="0.7"/>
          </svg>
          <div id="moleculeLayer"></div>
        </div>
        <div class="counts-caption"><span class="rc" id="rCount">24</span> Reactant &nbsp;&middot;&nbsp; <span class="pc" id="pCount">0</span> Product</div>
        <div class="disclaimer">"Speed" is conversions per second of this animation &mdash; an illustrative figure, not a real reaction rate.</div>
      </div>

      <div class="graph-side">
        <div class="panel-title">CONCENTRATION OVER TIME</div>
        <svg id="chart" viewBox="0 0 360 230" xmlns="http://www.w3.org/2000/svg"></svg>
        <div class="rates">
          <div class="box fwd">
            <div class="lbl"><span class="dot"></span>Reactant &rarr; Product</div>
            <div class="speed-caption">conversion speed</div>
            <div class="speed-big"><b id="fwdSpeed">0.0</b> <span class="unit">/ sec</span></div>
          </div>
          <div class="box rev">
            <div class="lbl"><span class="dot"></span>Product &rarr; Reactant</div>
            <div class="speed-caption">conversion speed</div>
            <div class="speed-big"><b id="revSpeed">0.0</b> <span class="unit">/ sec</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="controls">
      <button class="action primary" id="playPauseBtn">Pause</button>
      <button class="action" id="replayBtn">Replay</button>
    </div>

    <div class="status" id="statusLine">Reactant is turning into Product much faster than the reverse &mdash; but the reverse is happening too, just slowly.</div>
  </section>

  <footer class="credit">
    Sustainability: Science and Systems Thinking &mdash; Dynamic Equilibrium.<br>
    This animation was built with Claude (Anthropic).
  </footer>
</div>

<script>
(function(){
  "use strict";

  // ---- model (same approach-to-equilibrium curve as the main tool, K = 3) ----
  const K=3, XI_EQ=K/(1+K), TAU=2.15601531695703;
  const T_EQ=10.5, T_MAX=15;
  const KF=K/(TAU*(1+K)), KR=1/(TAU*(1+K));
  const N_TOTAL=24;
  function concAt(t){ const xi=XI_EQ*(1-Math.exp(-t/TAU)); return {R:1-xi,P:xi,fwdRate:KF*(1-xi),revRate:KR*xi}; }

  // ---- molecules ----
  const layer=document.getElementById('moleculeLayer');
  const LIQ={xmin:66,xmax:234,ymin:116,ymax:232};
  const MOL=15;
  function rand(a,b){ return a + Math.random()*(b-a); }
  const positions=[];
  function pickPos(){
    let best=null,bd=-1;
    for(let a=0;a<14;a++){
      const x=rand(LIQ.xmin,LIQ.xmax), y=rand(LIQ.ymin,LIQ.ymax);
      let md=Infinity;
      for(const p of positions){ const d=Math.hypot(p.x-x,p.y-y); if(d<md)md=d; }
      if(md>21) return {x,y};
      if(md>bd){bd=md;best={x,y};}
    }
    return best;
  }
  const molecules=[];
  for(let i=0;i<N_TOTAL;i++){
    const pos=pickPos(); positions.push(pos);
    const el=document.createElement('div'); el.className='molecule';
    const size=MOL*rand(0.88,1.12);
    el.style.width=size+'px'; el.style.height=size+'px';
    el.style.left=(pos.x-size/2)+'px'; el.style.top=(pos.y-size/2)+'px';
    const inner=document.createElement('div'); inner.className='m-jig';
    inner.style.setProperty('--jx1',rand(-3,3).toFixed(1)+'px');
    inner.style.setProperty('--jy1',rand(-3,3).toFixed(1)+'px');
    inner.style.setProperty('--jx2',rand(-3,3).toFixed(1)+'px');
    inner.style.setProperty('--jy2',rand(-3,3).toFixed(1)+'px');
    inner.style.setProperty('--jx3',rand(-3,3).toFixed(1)+'px');
    inner.style.setProperty('--jy3',rand(-3,3).toFixed(1)+'px');
    inner.style.animationDuration=rand(2.6,4.4).toFixed(2)+'s';
    inner.style.animationDelay=(-rand(0,4)).toFixed(2)+'s';
    el.appendChild(inner); layer.appendChild(el);
    molecules.push({el,inner,type:'reactant'});
  }
  function paint(m,type){
    m.type=type;
    const dark=type==='reactant'?'var(--reactant-dark)':'var(--product-dark)';
    const light=type==='reactant'?'var(--reactant-color)':'var(--product-color)';
    m.inner.style.background='radial-gradient(circle at 32% 28%, '+light+' 0%, '+light+' 35%, '+dark+' 100%)';
    m.inner.style.boxShadow='0 1px 3px rgba(0,0,0,0.35)';
  }
  molecules.forEach(m=>paint(m,'reactant'));

  function flipOne(fromType){
    const pool=molecules.filter(m=>m.type===fromType);
    if(pool.length===0) return false;
    const m=pool[Math.floor(Math.random()*pool.length)];
    paint(m, fromType==='reactant'?'product':'reactant');
    return true;
  }
  function reconcile(t){
    const {R}=concAt(t);
    const target=Math.round(R*N_TOTAL);
    let cur=molecules.filter(m=>m.type==='reactant').length;
    while(cur>target){ if(!flipOne('reactant'))break; cur--; }
    while(cur<target){ if(!flipOne('product'))break; cur++; }
  }

  // ---- graph ----
  const svg=document.getElementById('chart'), NS='http://www.w3.org/2000/svg';
  const PAD={l:42,r:14,t:12,b:32}, VW=360, VH=230;
  const pw=VW-PAD.l-PAD.r, ph=VH-PAD.t-PAD.b, YMAX=1.1;
  function X(t){return PAD.l+(t/T_MAX)*pw;} function Y(v){return PAD.t+ph-(v/YMAX)*ph;}
  function mk(tag,at){const e=document.createElementNS(NS,tag);for(const k in at)e.setAttribute(k,at[k]);return e;}
  const cs=getComputedStyle(document.documentElement);
  const rColor=cs.getPropertyValue('--reactant-color').trim(), pColor=cs.getPropertyValue('--product-color').trim();
  for(let v=0;v<=YMAX+1e-9;v+=0.2){
    svg.appendChild(mk('line',{x1:PAD.l,y1:Y(v),x2:VW-PAD.r,y2:Y(v),class:'gridline'}));
    const tx=mk('text',{x:PAD.l-7,y:Y(v)+4,class:'axis-label','text-anchor':'end'}); tx.textContent=v.toFixed(1); svg.appendChild(tx);
  }
  for(let tt=0;tt<=T_MAX;tt+=5){
    svg.appendChild(mk('line',{x1:X(tt),y1:PAD.t,x2:X(tt),y2:VH-PAD.b,class:'gridline'}));
    const tx=mk('text',{x:X(tt),y:VH-PAD.b+16,class:'axis-label','text-anchor':'middle'}); tx.textContent=tt; svg.appendChild(tx);
  }
  const yTitle=mk('text',{x:12,y:PAD.t+ph/2,class:'axis-title','text-anchor':'middle',transform:'rotate(-90 12 '+(PAD.t+ph/2)+')'}); yTitle.textContent='Concentration'; svg.appendChild(yTitle);
  const xTitle=mk('text',{x:PAD.l+pw/2,y:VH-3,class:'axis-title','text-anchor':'middle'}); xTitle.textContent='Time'; svg.appendChild(xTitle);
  const eqLine=mk('line',{class:'eqline',x1:X(T_EQ),y1:PAD.t,x2:X(T_EQ),y2:VH-PAD.b}); svg.appendChild(eqLine);
  const eqLabel=mk('text',{class:'eqline-label',x:X(T_EQ)+4,y:PAD.t+10}); eqLabel.textContent='equilibrium'; svg.appendChild(eqLabel);
  const pathR=mk('path',{class:'curve',stroke:rColor}); svg.appendChild(pathR);
  const pathP=mk('path',{class:'curve',stroke:pColor}); svg.appendChild(pathP);
  const tipR=mk('circle',{r:4,class:'tip',fill:rColor}); svg.appendChild(tipR);
  const tipP=mk('circle',{r:4,class:'tip',fill:pColor}); svg.appendChild(tipP);
  function drawGraph(t){
    const N=Math.max(2,Math.round((t/T_MAX)*160));
    let dR='',dP='';
    for(let i=0;i<=N;i++){ const tt=(i/N)*t,c=concAt(tt);
      dR+=(i===0?'M':'L')+X(tt).toFixed(2)+' '+Y(c.R).toFixed(2)+' ';
      dP+=(i===0?'M':'L')+X(tt).toFixed(2)+' '+Y(c.P).toFixed(2)+' ';
    }
    pathR.setAttribute('d',dR.trim()); pathP.setAttribute('d',dP.trim());
    const c=concAt(t);
    tipR.setAttribute('cx',X(t)); tipR.setAttribute('cy',Y(c.R));
    tipP.setAttribute('cx',X(t)); tipP.setAttribute('cy',Y(c.P));
    const on=(t>=T_EQ)?1:0; eqLine.style.opacity=on; eqLabel.style.opacity=on;
  }

  // ---- readouts ----
  const rCountEl=document.getElementById('rCount'), pCountEl=document.getElementById('pCount');
  const fwdSpeedEl=document.getElementById('fwdSpeed'), revSpeedEl=document.getElementById('revSpeed');
  const statusLine=document.getElementById('statusLine');
  const playPauseBtn=document.getElementById('playPauseBtn');

  // ---- self-running animation loop ----
  const APPROACH_SECS=16;               // real seconds to traverse t = 0 .. T_MAX
  const MODEL_PER_SEC=T_MAX/APPROACH_SECS;
  const FLIP_SCALE=26;                   // visible conversions per unit of rate*time
  const SMOOTH_TAU=0.5;                  // seconds; smoothing time-constant for the speed numbers

  let elapsed=0, playing=false, lastTs=null;
  let fwdAccum=0, revAccum=0;
  let fwdSpeedEMA=0, revSpeedEMA=0;

  function modelTime(){ return elapsed<=APPROACH_SECS ? Math.min(T_MAX, elapsed*MODEL_PER_SEC) : T_MAX; }

  function drawState(){
    const currentT=modelTime();
    reconcile(currentT);
    drawGraph(currentT);
    const rN=molecules.filter(m=>m.type==='reactant').length;
    rCountEl.textContent=rN; pCountEl.textContent=N_TOTAL-rN;
    fwdSpeedEl.textContent=fwdSpeedEMA.toFixed(1);
    revSpeedEl.textContent=revSpeedEMA.toFixed(1);
    if(currentT>=T_EQ){
      statusLine.className='status eq';
      statusLine.innerHTML='<b>Equilibrium reached.</b> Both directions now happen at the same speed — and they never stop.';
    } else {
      statusLine.className='status';
      statusLine.innerHTML='Reactant is turning into Product much faster than the reverse — but the reverse is happening too, just slowly.';
    }
  }

  function loop(ts){
    if(!playing) return;
    if(lastTs===null) lastTs=ts;
    let dt=(ts-lastTs)/1000; lastTs=ts;
    if(dt>0.1) dt=0.1;                   // cap after a tab-switch so nothing jumps
    elapsed += dt;

    const c=concAt(modelTime());
    const fwdInst=c.fwdRate*MODEL_PER_SEC*FLIP_SCALE;   // conversions per real second
    const revInst=c.revRate*MODEL_PER_SEC*FLIP_SCALE;
    const a=1-Math.exp(-dt/SMOOTH_TAU);
    fwdSpeedEMA += (fwdInst-fwdSpeedEMA)*a;
    revSpeedEMA += (revInst-revSpeedEMA)*a;

    fwdAccum += fwdInst*dt; revAccum += revInst*dt;
    while(fwdAccum>=1){ fwdAccum-=1; flipOne('reactant'); }
    while(revAccum>=1){ revAccum-=1; flipOne('product'); }

    drawState();
    requestAnimationFrame(loop);
  }

  function play(){
    if(playing) return;
    playing=true; lastTs=null;
    playPauseBtn.textContent='Pause';
    requestAnimationFrame(loop);
  }
  function pause(){
    playing=false;
    playPauseBtn.textContent='Play';
  }
  function replay(){
    pause();
    elapsed=0; fwdAccum=0; revAccum=0; fwdSpeedEMA=0; revSpeedEMA=0;
    molecules.forEach(m=>paint(m,'reactant'));
    drawState();
    play();
  }

  playPauseBtn.addEventListener('click', ()=>{ playing?pause():play(); });
  document.getElementById('replayBtn').addEventListener('click', replay);

  // initial draw, then auto-play (like the video)
  drawState();
  play();
})();
</script>
</body>
</html>
