<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Dynamic Equilibrium &mdash; Animation (Experimental)</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap');

  :root{
    --bg: #EEF3F6;
    --panel: #FFFFFF;
    --line: #D7E1E6;
    --text: #1B2733;
    --muted: #5B7480;
    --reactant-color: #065A82;
    --reactant-dark: #033F5C;
    --product-color: #C9822A;
    --product-dark: #8F5D1D;
    --good: #3F7D4F;
    --focus: #1C7293;
    --warn: #B8590A;
    --navy: #21295C;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background: var(--bg);
    color: var(--text);
    font-family:'Inter',sans-serif;
    min-height:100vh;
    padding: 32px 20px 60px;
  }
  .wrap{max-width: 940px; margin: 0 auto;}

  .experiment-flag{
    background: rgba(184,89,10,0.08); border:1px solid var(--warn); border-radius:8px;
    padding: 10px 16px; font-size:12.5px; color: var(--text); margin-bottom: 20px; line-height:1.5;
  }
  .experiment-flag b{color:var(--warn);}

  header.top{ margin-bottom: 22px; }
  header.top h1{
    font-family:'Source Serif 4', serif; font-weight:700; font-size: 26px;
    margin: 0 0 12px; color: var(--navy);
  }
  header.top p.sub{margin:10px 2px 0; color:var(--muted); font-size:13.5px; line-height:1.55; max-width:66ch;}

  .equation-banner{
    display:flex; align-items:center; justify-content:center;
    background: var(--panel); border:1px solid var(--line); border-radius:8px;
    padding: 14px 20px; box-shadow: 0 1px 3px rgba(33,41,92,0.06);
  }
  .equation-banner .eq{ font-family:'Source Serif 4', serif; font-size: 22px; font-weight:700; }
  .equation-banner .eq .r-c{color:var(--reactant-color);}
  .equation-banner .eq .p-c{color:var(--product-color);}

  section.panel{
    background: var(--panel); border:1px solid var(--line); border-radius:10px;
    padding: 20px; margin-top: 18px; box-shadow: 0 1px 3px rgba(33,41,92,0.06);
  }

  .stage{display:grid; grid-template-columns: 1fr 1fr; gap:22px; align-items:start;}
  @media (max-width: 720px){ .stage{grid-template-columns:1fr;} }

  .beaker-side{display:flex; flex-direction:column; align-items:center;}
  .panel-title{font-size:12px; color:var(--muted); margin-bottom:8px; text-align:center; letter-spacing:.02em;}
  .beaker-stage{ position:relative; width:280px; height:250px; }
  .beaker-stage svg.glass{position:absolute; top:0; left:0; width:280px; height:250px; overflow:visible;}
  .molecule{ position:absolute; border-radius:50%; }
  .molecule .m-jig{
    width:100%; height:100%; border-radius:50%;
    animation-name: jiggle; animation-iteration-count: infinite; animation-timing-function: ease-in-out;
  }
  @keyframes jiggle{
    0%{transform:translate(0,0);} 25%{transform:translate(var(--jx1),var(--jy1));}
    50%{transform:translate(var(--jx2),var(--jy2));} 75%{transform:translate(var(--jx3),var(--jy3));}
    100%{transform:translate(0,0);}
  }
  .molecule.flip .m-jig{ animation-name: jiggle, flipPulse; animation-duration: inherit, 0.6s; animation-iteration-count: infinite, 1; }
  @keyframes flipPulse{
    0%{ box-shadow:0 0 0 0 rgba(28,114,147,0.9); }
    55%{ box-shadow:0 0 0 10px rgba(28,114,147,0); }
    100%{ box-shadow:0 0 0 0 rgba(28,114,147,0); }
  }

  .flip-feed{margin-top:12px; height:44px; display:flex; flex-direction:column; gap:3px; align-items:center; justify-content:center;}
  .flip-msg{font-size:12.5px; font-family:'IBM Plex Mono',monospace; opacity:0; transition:opacity .2s;}
  .flip-msg.fwd{color:var(--reactant-color);}
  .flip-msg.rev{color:var(--product-color);}
  .flip-msg.show{opacity:1;}

  .graph-side{min-width:0;}
  svg#chart{width:100%; height:auto; display:block;}
  .gridline{stroke:#E3E9EC; stroke-width:1;}
  .axis-label{fill:var(--muted); font-size:11px; font-family:'IBM Plex Mono',monospace;}
  .axis-title{fill:var(--muted); font-size:12px; font-family:'Inter',sans-serif;}
  .curve{fill:none; stroke-width:2.5;}
  .tip{stroke:#FFFFFF; stroke-width:2;}
  .eqline{stroke:var(--good); stroke-width:1.5; stroke-dasharray:5 4; opacity:0;}
  .eqline-label{fill:var(--good); font-size:11px; font-family:'IBM Plex Mono',monospace; opacity:0;}

  .controls{display:flex; gap:10px; margin-top:20px; justify-content:center; flex-wrap:wrap;}
  button.action{
    cursor:pointer; font-family:'Inter',sans-serif; font-weight:600; font-size:13.5px;
    padding:9px 20px; border-radius:6px; border:1px solid var(--line);
    background: #F5F8FA; color: var(--text); transition: border-color .15s ease, background .15s ease;
  }
  button.action:hover{border-color: var(--focus);}
  button.action.primary{background: var(--focus); border-color: var(--focus); color:#FFFFFF;}

  .status{
    margin-top:18px; padding:12px 16px; border-radius:6px; font-size:13.5px;
    background:#F5F8FA; border:1px solid var(--line); color:var(--text); line-height:1.55; text-align:center;
  }
  .status.ready{border-color: var(--good); background: rgba(63,125,79,0.08);}

  footer.credit{ text-align:center; color:var(--muted); font-size:11.5px; margin-top:26px; line-height:1.6;}
</style>
</head>
<body>
<div class="wrap">

  <div class="experiment-flag">
    <b>Experimental prototype &mdash; standalone.</b> A self-contained animation of dynamic equilibrium, separate from the main "Approaching Equilibrium" tool. Press play and watch: the reaction runs on its own, no dragging needed.
  </div>

  <header class="top">
    <h1>Dynamic Equilibrium</h1>
    <div class="equation-banner">
      <div class="eq"><span class="r-c">Reactant</span> &#8652; <span class="p-c">Product</span></div>
    </div>
    <p class="sub">Watch the reaction run on its own. Early on, Reactant turns into Product far more often than the reverse &mdash; but look closely: the reverse conversion is happening too, just rarely. As the reaction settles into equilibrium, the two directions happen equally often, and they never stop.</p>
  </header>

  <section class="panel">
    <div class="stage">
      <div class="beaker-side">
        <div class="panel-title">THE MOLECULES</div>
        <div class="beaker-stage" id="beakerStage">
          <svg class="glass" viewBox="0 0 280 250">
            <defs>
              <linearGradient id="liquidGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#CFE3EA" stop-opacity="0.65"/>
                <stop offset="100%" stop-color="#AEC8D3" stop-opacity="0.8"/>
              </linearGradient>
              <linearGradient id="glassGrad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#8FA6AE" stop-opacity="0.7"/>
                <stop offset="12%" stop-color="#FFFFFF" stop-opacity="0.9"/>
                <stop offset="20%" stop-color="#8FA6AE" stop-opacity="0.55"/>
                <stop offset="80%" stop-color="#8FA6AE" stop-opacity="0.55"/>
                <stop offset="88%" stop-color="#FFFFFF" stop-opacity="0.9"/>
                <stop offset="100%" stop-color="#8FA6AE" stop-opacity="0.7"/>
              </linearGradient>
            </defs>
            <path d="M 52 96 L 66 222 L 214 222 L 228 96 Z" fill="url(#liquidGrad)"/>
            <path d="M 52 96 L 228 96" stroke="#6E8B96" stroke-width="1.5" opacity="0.6"/>
            <g stroke="#6E8B96" stroke-width="1.5" opacity="0.65">
              <line x1="58" y1="130" x2="67" y2="130"/>
              <line x1="61" y1="165" x2="70" y2="165"/>
              <line x1="64" y1="200" x2="73" y2="200"/>
            </g>
            <path d="M 44 22 L 66 222 L 214 222 L 236 22" fill="none" stroke="url(#glassGrad)" stroke-width="4" stroke-linejoin="round" stroke-linecap="round"/>
            <path d="M 44 22 L 66 222 L 214 222 L 236 22" fill="none" stroke="#7A96A0" stroke-width="1" stroke-linejoin="round" stroke-linecap="round" opacity="0.7"/>
          </svg>
          <div id="moleculeLayer"></div>
        </div>
        <div class="flip-feed">
          <div class="flip-msg fwd" id="msgFwd">Reactant &rarr; Product</div>
          <div class="flip-msg rev" id="msgRev">Product &rarr; Reactant</div>
        </div>
      </div>

      <div class="graph-side">
        <div class="panel-title">CONCENTRATION OVER TIME</div>
        <svg id="chart" viewBox="0 0 340 250" xmlns="http://www.w3.org/2000/svg"></svg>
      </div>
    </div>

    <div class="controls">
      <button class="action primary" id="playPauseBtn">Play</button>
      <button class="action" id="replayBtn">Replay</button>
    </div>

    <div class="status" id="statusLine">Press play to start the reaction.</div>
  </section>

  <footer class="credit">
    Sustainability: Science and Systems Thinking &mdash; Dynamic Equilibrium (Animation Prototype).<br>
    Reactant and Product are a generic, illustrative reaction &mdash; not a real measured reaction. This simulation was built with Claude (Anthropic).
  </footer>
</div>

<script>
(function(){
  "use strict";

  // ---- model (same approach-to-equilibrium curve as the main tool, K = 3) ----
  const K = 3;
  const XI_EQ = K/(1+K);
  const TAU = 2.15601531695703;
  const T_EQ = 10.5;         // where equilibrium is reached, in model time units
  const T_MAX = 15;          // model time shown on the graph
  const KF = K/(TAU*(1+K));
  const KR = 1/(TAU*(1+K));
  const N_TOTAL = 24;

  const ANIM_SECONDS = 20;   // real seconds for the animation to traverse t=0..T_MAX
  const MODEL_PER_SEC = T_MAX / ANIM_SECONDS;

  function concAt(t){
    const xi = XI_EQ*(1-Math.exp(-t/TAU));
    return { R:1-xi, P:xi, fwdRate:KF*(1-xi), revRate:KR*xi };
  }

  // ---- molecules ----
  const layer = document.getElementById('moleculeLayer');
  const LIQ = {xmin:62, xmax:218, ymin:106, ymax:214};
  const MOL_SIZE = 15;
  function rand(a,b){ return a + Math.random()*(b-a); }

  const positions = [];
  function pickPos(){
    let best=null, bestD=-1;
    for(let a=0;a<12;a++){
      const x=rand(LIQ.xmin,LIQ.xmax), y=rand(LIQ.ymin,LIQ.ymax);
      let md=Infinity;
      for(const p of positions){ const d=Math.hypot(p.x-x,p.y-y); if(d<md) md=d; }
      if(md>20) return {x,y};
      if(md>bestD){ bestD=md; best={x,y}; }
    }
    return best;
  }

  const molecules = [];
  for(let i=0;i<N_TOTAL;i++){
    const pos = pickPos(); positions.push(pos);
    const el = document.createElement('div'); el.className='molecule';
    const size = MOL_SIZE*rand(0.85,1.15);
    el.style.width=size+'px'; el.style.height=size+'px';
    el.style.left=(pos.x-size/2)+'px'; el.style.top=(pos.y-size/2)+'px';
    const inner=document.createElement('div'); inner.className='m-jig';
    inner.style.setProperty('--jx1',rand(-3,3).toFixed(1)+'px');
    inner.style.setProperty('--jy1',rand(-3,3).toFixed(1)+'px');
    inner.style.setProperty('--jx2',rand(-3,3).toFixed(1)+'px');
    inner.style.setProperty('--jy2',rand(-3,3).toFixed(1)+'px');
    inner.style.setProperty('--jx3',rand(-3,3).toFixed(1)+'px');
    inner.style.setProperty('--jy3',rand(-3,3).toFixed(1)+'px');
    inner.style.animationDuration=rand(2.6,4.4).toFixed(2)+'s';
    inner.style.animationDelay=(-rand(0,4)).toFixed(2)+'s';
    el.appendChild(inner); layer.appendChild(el);
    molecules.push({el,inner,type:'reactant'});
  }
  function paint(m,type){
    m.type=type;
    const dark = type==='reactant'?'var(--reactant-dark)':'var(--product-dark)';
    const light = type==='reactant'?'var(--reactant-color)':'var(--product-color)';
    m.inner.style.background='radial-gradient(circle at 32% 28%, '+light+' 0%, '+light+' 35%, '+dark+' 100%)';
    m.inner.style.boxShadow='0 1px 3px rgba(0,0,0,0.35)';
  }
  molecules.forEach(m=>paint(m,'reactant'));

  function pulse(m){
    m.el.classList.remove('flip'); void m.el.offsetWidth; m.el.classList.add('flip');
  }
  // convert one molecule of `fromType` to the other, return true if one was available
  function flipOne(fromType){
    const pool = molecules.filter(m=>m.type===fromType);
    if(pool.length===0) return false;
    const m = pool[Math.floor(Math.random()*pool.length)];
    paint(m, fromType==='reactant'?'product':'reactant');
    pulse(m);
    return true;
  }

  // keep the molecule field's counts matched to the model concentration at time t
  function reconcileCounts(t){
    const {R} = concAt(t);
    const targetR = Math.round(R*N_TOTAL);
    let curR = molecules.filter(m=>m.type==='reactant').length;
    // this only corrects drift; the visible flips below are what the student actually watches
    while(curR > targetR){ if(!flipOne('reactant')) break; curR--; }
    while(curR < targetR){ if(!flipOne('product')) break; curR++; }
  }

  // ---- graph ----
  const svg=document.getElementById('chart');
  const NS='http://www.w3.org/2000/svg';
  const PAD={l:40,r:12,t:14,b:34}, VW=340, VH=250;
  const pw=VW-PAD.l-PAD.r, ph=VH-PAD.t-PAD.b, YMAX=1.1;
  function X(t){ return PAD.l+(t/T_MAX)*pw; }
  function Y(v){ return PAD.t+ph-(v/YMAX)*ph; }
  function mk(tag,at){ const e=document.createElementNS(NS,tag); for(const k in at) e.setAttribute(k,at[k]); return e; }
  const cs=getComputedStyle(document.documentElement);
  const rColor=cs.getPropertyValue('--reactant-color').trim();
  const pColor=cs.getPropertyValue('--product-color').trim();

  for(let v=0;v<=YMAX+1e-9;v+=0.2){
    svg.appendChild(mk('line',{x1:PAD.l,y1:Y(v),x2:VW-PAD.r,y2:Y(v),class:'gridline'}));
    const tx=mk('text',{x:PAD.l-7,y:Y(v)+4,class:'axis-label','text-anchor':'end'}); tx.textContent=v.toFixed(1); svg.appendChild(tx);
  }
  for(let tt=0;tt<=T_MAX;tt+=5){
    svg.appendChild(mk('line',{x1:X(tt),y1:PAD.t,x2:X(tt),y2:VH-PAD.b,class:'gridline'}));
    const tx=mk('text',{x:X(tt),y:VH-PAD.b+17,class:'axis-label','text-anchor':'middle'}); tx.textContent=tt; svg.appendChild(tx);
  }
  const yTitle=mk('text',{x:12,y:PAD.t+ph/2,class:'axis-title','text-anchor':'middle',transform:'rotate(-90 12 '+(PAD.t+ph/2)+')'}); yTitle.textContent='Concentration'; svg.appendChild(yTitle);
  const xTitle=mk('text',{x:PAD.l+pw/2,y:VH-4,class:'axis-title','text-anchor':'middle'}); xTitle.textContent='Time'; svg.appendChild(xTitle);

  const eqLine=mk('line',{class:'eqline',x1:X(T_EQ),y1:PAD.t,x2:X(T_EQ),y2:VH-PAD.b}); svg.appendChild(eqLine);
  const eqLabel=mk('text',{class:'eqline-label',x:X(T_EQ)+4,y:PAD.t+10}); eqLabel.textContent='equilibrium'; svg.appendChild(eqLabel);
  const pathR=mk('path',{class:'curve',stroke:rColor}); svg.appendChild(pathR);
  const pathP=mk('path',{class:'curve',stroke:pColor}); svg.appendChild(pathP);
  const tipR=mk('circle',{r:4,class:'tip',fill:rColor}); svg.appendChild(tipR);
  const tipP=mk('circle',{r:4,class:'tip',fill:pColor}); svg.appendChild(tipP);

  function drawGraph(t){
    const N=Math.max(2,Math.round((t/T_MAX)*140));
    let dR='',dP='';
    for(let i=0;i<=N;i++){
      const tt=(i/N)*t; const c=concAt(tt);
      dR+=(i===0?'M':'L')+X(tt).toFixed(2)+' '+Y(c.R).toFixed(2)+' ';
      dP+=(i===0?'M':'L')+X(tt).toFixed(2)+' '+Y(c.P).toFixed(2)+' ';
    }
    pathR.setAttribute('d',dR.trim()); pathP.setAttribute('d',dP.trim());
    const c=concAt(t);
    tipR.setAttribute('cx',X(t)); tipR.setAttribute('cy',Y(c.R));
    tipP.setAttribute('cx',X(t)); tipP.setAttribute('cy',Y(c.P));
    if(t>=T_EQ){ eqLine.style.opacity=1; eqLabel.style.opacity=1; }
    else { eqLine.style.opacity=0; eqLabel.style.opacity=0; }
  }

  // ---- flip feed messages ----
  const msgFwd=document.getElementById('msgFwd'), msgRev=document.getElementById('msgRev');
  let fwdTimer=null, revTimer=null;
  function flashFwd(){ msgFwd.classList.add('show'); clearTimeout(fwdTimer); fwdTimer=setTimeout(()=>msgFwd.classList.remove('show'),260); }
  function flashRev(){ msgRev.classList.add('show'); clearTimeout(revTimer); revTimer=setTimeout(()=>msgRev.classList.remove('show'),260); }

  // ---- animation loop ----
  const statusLine=document.getElementById('statusLine');
  const playPauseBtn=document.getElementById('playPauseBtn');
  let modelT=0, playing=false, lastReal=null;
  // independent flip scheduling: forward and reverse each fire on their own timers,
  // frequency proportional to their current rate -> student SEES the rate difference.
  let fwdAccum=0, revAccum=0;
  const FLIP_SCALE = 26; // tunes how many visible flips per unit of rate*time

  function updateStatus(){
    if(modelT>=T_EQ){
      statusLine.className='status ready';
      statusLine.innerHTML='<b>Equilibrium.</b> Both directions are now happening equally often \u2014 and they never stop. The overall amounts hold steady.';
    } else {
      statusLine.className='status';
      statusLine.innerHTML='Reactant is turning into Product more often than the reverse \u2014 but notice the reverse is happening too, just less often.';
    }
  }

  // once time reaches T_MAX we keep the loop running so flips continue forever at the
  // equilibrium rate (concentrations hold steady, but conversion never stops).
  function frameLoop(now){
    if(!playing) return;
    if(lastReal===null) lastReal=now;
    let dtReal=(now-lastReal)/1000; lastReal=now;
    if(dtReal>0.1) dtReal=0.1;

    if(modelT < T_MAX){
      modelT=Math.min(T_MAX, modelT + dtReal*MODEL_PER_SEC);
    }
    const c=concAt(modelT);
    fwdAccum += c.fwdRate * dtReal * MODEL_PER_SEC * FLIP_SCALE;
    revAccum += c.revRate * dtReal * MODEL_PER_SEC * FLIP_SCALE;
    let didFwd=false, didRev=false;
    while(fwdAccum>=1){ fwdAccum-=1; if(flipOne('reactant')) didFwd=true; }
    while(revAccum>=1){ revAccum-=1; if(flipOne('product')) didRev=true; }
    if(didFwd) flashFwd();
    if(didRev) flashRev();
    reconcileCounts(modelT);
    drawGraph(modelT);
    updateStatus();
    requestAnimationFrame(frameLoop);
  }

  function play(){
    if(playing) return;
    playing=true; lastReal=null;
    playPauseBtn.textContent='Pause';
    requestAnimationFrame(frameLoop);
  }
  function pause(){
    playing=false;
    playPauseBtn.textContent='Play';
  }
  function replay(){
    pause();
    modelT=0; fwdAccum=0; revAccum=0;
    molecules.forEach(m=>paint(m,'reactant'));
    drawGraph(0); updateStatus();
    statusLine.className='status';
    statusLine.innerHTML='Press play to start the reaction.';
    setTimeout(play, 80);
  }

  playPauseBtn.addEventListener('click', ()=>{ playing?pause():play(); });
  document.getElementById('replayBtn').addEventListener('click', replay);

  // initial state
  drawGraph(0);
})();
</script>
</body>
</html>
